# Copy this file to .env on the server. Do not commit .env and never send it in chat.
# Write values after "=" without quotation marks, brackets, or angle brackets.
# Example: TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenOnly_DoNotUse

# --- Application and HTTPS origin ---
APP_ENV=production
# Keep false on the VPS. Reload mode is only for local editing.
APP_RELOAD=false
# Exact public HTTPS origins: no wildcard, path, trailing slash, localhost, or HTTP.
APP_ALLOWED_ORIGINS=https://airdrop-x.com,https://www.airdrop-x.com
# Set true only after Nginx is installed on this VPS and is the only public proxy.
APP_TRUST_PROXY_HEADERS=true

# Production process contract (documentation only, not additional env keys):
# run exactly one Uvicorn worker because SQLite, APScheduler and short-lived
# quote/session caches are process-local; run tg_bot.py as a separate singleton.

# --- Subscription payments ---
# Keep false until the exact USDC settlement flow is configured and tested.
# Never enable a payment method whose displayed currency differs from the asset verified on-chain.
SUBSCRIPTION_PAYMENTS_ENABLED=false
# Use testnet for a first technical test. Change to mainnet only after confirming
# the receiver address and a small real payment end-to-end.
SUBSCRIPTION_PAYMENT_MODE=testnet
# This is a public address, not a private key. Do not use the fallback in production.
SUBSCRIPTION_PAYMENT_RECEIVER=0xYOUR_PUBLIC_USDC_RECEIVING_ADDRESS
# Temporary owner-only validation of the production payment path. Keep false
# unless an admin is deliberately performing the one-time 1 USDC check.
# This never activates a subscription and is not shown to ordinary users.
ADMIN_PAYMENT_TEST_ENABLED=false

# --- Telegram ---
# Create or revoke the token in @BotFather. This is a secret.
TELEGRAM_BOT_TOKEN=REPLACE_WITH_BOTFATHER_TOKEN
# Public bot username, without @. This is not a secret.
TELEGRAM_BOT_USERNAME=REPLACE_WITH_BOT_USERNAME

# --- WalletConnect / Reown ---
# Create the project in dashboard.reown.com and allowlist both public domains.
WALLETCONNECT_PROJECT_ID=REPLACE_WITH_REOWN_PROJECT_ID

# --- Provider API keys ---
# Uniswap Trading API key for the server-side Base Swap quote service. Keep it private.
UNISWAP_API_KEY=REPLACE_WITH_UNISWAP_API_KEY

# Optional LI.FI API key for higher bridge API limits. Leave empty to use the
# public route endpoint where available. Never expose the value in the browser.
LIFI_API_KEY=

# Optional OKX read-only balance integration. Leave all three empty unless it is enabled.
# Give the key only Read permission, bind it to the VPS IP, and never grant Withdraw.
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSWORD=

# Comma-separated usernames allowed to manage official sources. Leave empty for no access.
AIRDROP_ADMIN_USERNAMES=Admin

# --- Email delivery ---
# Gmail App Password for airdrop.x.support@gmail.com. This is not the Gmail account password.
SMTP_PASSWORD=REPLACE_WITH_16_CHARACTER_GMAIL_APP_PASSWORD

# One-time owner bootstrap for a completely empty production database.
# Keep disabled normally. The server automatically stops this flow after the
# first account is created; set it back to false afterwards as a safeguard.
INITIAL_ADMIN_BOOTSTRAP_ENABLED=false
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_USERNAME=Admin
