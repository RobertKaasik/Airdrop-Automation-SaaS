APP_ENV=development
APP_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Create the token with @BotFather. Never commit the real value.
TELEGRAM_BOT_TOKEN=
# Bot username without @, for example: AirdropX_Support_Bot
TELEGRAM_BOT_USERNAME=

# Reown / WalletConnect project configuration
WALLETCONNECT_PROJECT_ID=

# Optional email delivery settings
SMTP_PASSWORD=
