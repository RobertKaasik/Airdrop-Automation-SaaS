APP_ENV=development
APP_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# Set to true only behind your own trusted reverse proxy (for example, Render).
# Do not enable it for a directly exposed local server.
APP_TRUST_PROXY_HEADERS=false

# Keep false until the exact USDC subscription-settlement flow is configured
# and tested. Never enable a payment method whose displayed currency differs
# from the asset verified on-chain.
SUBSCRIPTION_PAYMENTS_ENABLED=false
# Use testnet while developing locally; mainnet is only for a reviewed launch.
SUBSCRIPTION_PAYMENT_MODE=testnet
# Base Sepolia verifies a safe 1.00 test USDC payment; real plan prices are
# used only in reviewed mainnet mode.
# Optional: receiver address for subscription USDC. If omitted, the configured
# AIRDROP-X receiver is used. Never enter a private key here.
# SUBSCRIPTION_PAYMENT_RECEIVER=0xYourPublicReceiverAddress

# Create the token with @BotFather. Never commit the real value.
TELEGRAM_BOT_TOKEN=
# Bot username without @, for example: AirdropX_Support_Bot
TELEGRAM_BOT_USERNAME=

# Reown / WalletConnect project configuration
WALLETCONNECT_PROJECT_ID=

# Uniswap Trading API key for the server-side Base Swap quote service. Keep it private.
UNISWAP_API_KEY=

# Comma-separated usernames allowed to manage official sources. Leave empty for no access.
AIRDROP_ADMIN_USERNAMES=Admin

# Optional email delivery settings
SMTP_PASSWORD=
