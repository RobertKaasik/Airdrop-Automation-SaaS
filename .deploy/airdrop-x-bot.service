[Unit]
Description=AIRDROP-X Telegram bot
After=network-online.target airdrop-x-web.service
Wants=network-online.target

[Service]
Type=simple
User=airdropx
Group=airdropx
WorkingDirectory=/srv/airdrop-x
EnvironmentFile=/srv/airdrop-x/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/srv/airdrop-x/.venv/bin/python tg_bot.py
Restart=on-failure
RestartSec=10
UMask=027
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
